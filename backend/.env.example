# Copie para .env e ajuste os valores.
# Nunca commite o arquivo .env.

# ── Server ────────────────────────────────────
PORT=3001
NODE_ENV=development
API_VERSION=v0
FRONTEND_URL=http://localhost:3000

# ── Branding ──────────────────────────────────
APP_NAME=Memorinhas
API_TITLE=Memorinhas API
SWAGGER_DESCRIPTION=API documentation for Memorinhas Core
STORE_NAME=Memorinhas
STORE_BRAND_URL=memorinhas
APP_LOGO_URL=

# ── Feature Flags ─────────────────────────────
FEATURE_SEEDING=true

# ── System Admin ────
SYSTEM_ADMIN_NAME=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

# ── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_HOST_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=memorinhas_db

# ── Deploy / CORS ─────────────────────────────
APP_PUBLIC_URL=https://memorinhas-api.thalysdev.com

# ── JWT ───────────────────────────────────────
# Gere um valor forte em produção (ex.: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-in-production

# ── Mail ──────────────────────────────────────
MAIL_DRIVER=console
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Memorinhas
MAIL_SUPPORT_EMAIL=

# ── Cloudinary ────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
