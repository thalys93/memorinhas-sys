<p style="margin:0 0 8px;font-size:22px;font-weight:600;letter-spacing:-0.02em;color:#1d1d1f;">Atualização do pedido</p>
{{#if customMessage}}
<p style="margin:0 0 24px;font-size:16px;color:#1d1d1f;line-height:1.55;">{{customMessage}}</p>
{{/if}}
{{#if isDefault}}
<p style="margin:0 0 24px;font-size:16px;color:#6e6e73;">Olá {{customerName}}, seu pedido em <strong style="color:#1d1d1f;font-weight:500;">{{storeName}}</strong> foi atualizado.</p>
{{/if}}

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f5f7;border-radius:12px;margin-bottom:20px;">
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0 0 4px;font-size:13px;color:#6e6e73;">Pedido</p>
      <p style="margin:0 0 12px;font-size:16px;font-weight:500;color:#1d1d1f;">#{{orderId}}</p>
      <p style="margin:0 0 4px;font-size:13px;color:#6e6e73;">Status</p>
      <p style="margin:0;font-size:16px;font-weight:500;color:#1d1d1f;">{{statusLabel}}</p>
    </td>
  </tr>
</table>

{{itemsHtml}}

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:8px;">
  <tr>
    <td style="padding:10px 0 0;font-size:16px;font-weight:600;color:#1d1d1f;border-top:1px solid #d2d2d7;">Total</td>
    <td style="padding:10px 0 0;font-size:16px;font-weight:600;color:#1d1d1f;text-align:right;border-top:1px solid #d2d2d7;">{{total}}</td>
  </tr>
</table>
