<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{appName}}{{#if pageTitle}} — {{pageTitle}}{{/if}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body style="margin:0;padding:0;background:#f5f5f7;color:#1d1d1f;font-family:Outfit,system-ui,-apple-system,Segoe UI,sans-serif;-webkit-font-smoothing:antialiased;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f5f5f7;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background:#ffffff;border:1px solid #d2d2d7;border-radius:18px;overflow:hidden;">
          <tr>
            <td style="height:4px;background:#8a6240;font-size:0;line-height:0;">&nbsp;</td>
          </tr>
          <tr>
            <td style="padding:28px 28px 8px;text-align:center;">
              <img src="{{logoUrl}}" alt="{{appName}}" width="120" height="120" style="display:block;margin:0 auto;width:120px;height:auto;border:0;outline:none;text-decoration:none;" />
            </td>
          </tr>
          <tr>
            <td style="padding:8px 28px 32px;font-size:16px;line-height:1.55;color:#1d1d1f;">
              {{body}}
            </td>
          </tr>
        </table>
        <p style="margin:20px 0 0;font-size:13px;color:#6e6e73;text-align:center;">Mensagem automática — não responda.</p>
      </td>
    </tr>
  </table>
</body>
</html>
