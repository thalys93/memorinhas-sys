<p style="margin:0 0 8px;font-size:22px;font-weight:600;letter-spacing:-0.02em;color:#1d1d1f;">Pedido confirmado</p>
<p style="margin:0 0 24px;font-size:16px;color:#6e6e73;">Olá {{customerName}}, recebemos seu pedido em <strong style="color:#1d1d1f;font-weight:500;">{{storeName}}</strong>.</p>

<p style="margin:0 0 4px;font-size:13px;color:#6e6e73;">Pedido</p>
<p style="margin:0 0 20px;font-size:16px;font-weight:500;color:#1d1d1f;">#{{orderId}}</p>

{{itemsHtml}}

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:8px;margin-bottom:20px;">
  <tr>
    <td style="padding:6px 0;font-size:14px;color:#6e6e73;">Subtotal</td>
    <td style="padding:6px 0;font-size:14px;color:#1d1d1f;text-align:right;">{{subtotal}}</td>
  </tr>
  <tr>
    <td style="padding:6px 0;font-size:14px;color:#6e6e73;">Frete</td>
    <td style="padding:6px 0;font-size:14px;color:#1d1d1f;text-align:right;">{{freight}}</td>
  </tr>
  <tr>
    <td style="padding:10px 0 0;font-size:16px;font-weight:600;color:#1d1d1f;border-top:1px solid #d2d2d7;">Total</td>
    <td style="padding:10px 0 0;font-size:16px;font-weight:600;color:#1d1d1f;text-align:right;border-top:1px solid #d2d2d7;">{{total}}</td>
  </tr>
</table>

<p style="margin:0 0 4px;font-size:13px;color:#6e6e73;">Pagamento</p>
<p style="margin:0 0 12px;font-size:15px;color:#1d1d1f;">{{paymentMethod}}</p>
<p style="margin:0 0 4px;font-size:13px;color:#6e6e73;">CEP</p>
<p style="margin:0;font-size:15px;color:#1d1d1f;">{{cep}}</p>
